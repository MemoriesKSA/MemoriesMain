# Public site URL after the first Vercel deployment
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only email delivery (never prefix these with NEXT_PUBLIC_)
RESEND_API_KEY=
RESEND_FROM_EMAIL=MEMORIES Journeys <journeys@send.memories.tours>
JOURNEY_REVIEW_EMAIL=memoriesksasupport@gmail.com

# Newsletter signups are stored as consented contacts in Resend.
# A full-access Resend key is required for contact management.

# "Ask MEMORIES" AI concierge (server-only). Get a key at console.anthropic.com
# under API Keys, then add it here and in Vercel's Environment Variables.
ANTHROPIC_API_KEY=

# Supabase (proposals database + reviewer login). Get these from your Supabase
# project's Settings > API page. SUPABASE_SERVICE_ROLE_KEY bypasses row-level
# security and must stay server-only, never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated emails allowed to log in to /internal (the reviewer tool).
REVIEWER_ALLOWED_EMAILS=

# Moyasar payments (plan unlocks). All server-only. With no keys set, the
# unlock button stays disabled, so these can be left empty until the account
# exists. Use test keys (pk_test_/sk_test_) first; a live publishable key with
# a test secret key is refused on purpose.
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=
# The shared secret set on the webhook in Moyasar's dashboard. Point the
# webhook at https://memories.tours/api/payments/moyasar/webhook for payment_paid.
MOYASAR_WEBHOOK_SECRET=
# Which methods the form offers, comma-separated. Only list a wallet once its
# own setup is done: applepay after the domain is registered with Moyasar (their
# verification file goes in public/.well-known/), stcpay once enabled on the
# account, samsungpay once SAMSUNG_PAY_SERVICE_ID is set. Defaults to creditcard.
MOYASAR_METHODS=creditcard
SAMSUNG_PAY_SERVICE_ID=
